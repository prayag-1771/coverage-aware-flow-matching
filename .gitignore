# Datasets — never commit. See PLAN.md §4 for sources.
# Leading slash anchors this to the repo root so it does not also match src/data/.
/data/

# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# Results — every artifact here is regenerable by re-running experiments/,
# so nothing in this directory is tracked except the placeholder.
results/*
!results/.gitkeep

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
